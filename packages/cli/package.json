{
  "name": "protoshare",
  "version": "0.1.0",
  "description": "Share local Storybook/Vite/Next prototypes as a snapshot gallery",
  "license": "MIT",
  "type": "module",
  "bin": {
    "protoshare": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unhexx/protoshare.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "prepack": "tsx src/build.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@protoshare/capture": "workspace:*",
    "@protoshare/core": "workspace:*",
    "@protoshare/live": "workspace:*",
    "@protoshare/share-app": "workspace:*",
    "citty": "^0.1.6",
    "esbuild": "^0.25.9",
    "uqr": "^0.1.3"
  }
