{
  "name": "@protoshare/overlay",
  "version": "0.1.0",
  "description": "Share button overlay for local Storybook, Vite, and Next.js previews",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./storybook": "./dist/storybook.js",
    "./manager": "./dist/manager.js",
    "./next": "./dist/next.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
