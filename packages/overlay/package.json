{
  "name": "@protoshare/overlay",
  "version": "0.1.0",
  "description": "Share button overlay for local Storybook, Vite, and Next.js previews",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./storybook": {
      "types": "./dist/storybook.d.ts",
      "import": "./dist/storybook.js"
    },
    "./manager": {
      "types": "./dist/manager-entry.d.ts",
      "import": "./dist/manager.js"
    },
    "./next": {
      "types": "./dist/next-entry.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unhexx/protoshare.git",
    "directory": "packages/overlay"
  },
  "homepage": "https://github.com/unhexx/protoshare#readme",
  "bugs": {
    "url": "https://github.com/unhexx/protoshare/issues"
  },
  "keywords": [
    "storybook",
    "vite",
    "nextjs",
    "overlay",
    "addon",
    "share",
    "prototype"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "prepack": "tsx src/build.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "storybook": "^8 || ^9"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "storybook": { "optional": true }
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
